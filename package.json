{
  "name": "eyes-widget",
  "version": "1.0.0",
  "description": "A minimal floating image/GIF widget with atmospheric dark aesthetics",
  "author": "Goga",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build": "electron-builder --win --linux"
  },
  "build": {
    "appId": "com.eyes.widget",
    "productName": "EYES",
    "icon": "./src/assets/Ghibli.ico",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "./src/assets/Ghibli.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "./src/assets/Ghibli.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
